<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\UMS.Shared.Observability\UMS.Shared.Observability.csproj" />
    <ProjectReference Include="..\..\src\Shared\UMS.Shared.ErrorHandling\UMS.Shared.ErrorHandling.csproj" />
    <ProjectReference Include="..\..\src\Shared\UMS.Shared.Resilience\UMS.Shared.Resilience.csproj" />
    <ProjectReference Include="..\..\src\Shared\UMS.Shared.Authorization\UMS.Shared.Authorization.csproj" />
    <ProjectReference Include="..\..\src\Shared\UMS.Shared.Domain\UMS.Shared.Domain.csproj" />
    <ProjectReference Include="..\..\src\Host\UMS.Host.csproj" />
    <ProjectReference Include="..\..\src\Workers\UMS.Workers\UMS.Workers.csproj" />
    <!--
      Referenced so each UMS.Modules.*.dll actually lands next to this test assembly - that's what
      makes Modules_do_not_reference_another_modules_internals stop running vacuously (see this
      test class's own remarks). Only Domain/Application/Infrastructure are referenced here (never
      Api, which legitimately depends on Application) since those three are exactly what the
      module-isolation rule forbids another module from reaching into.
    -->
    <ProjectReference Include="..\..\src\UMS.Modules\Identity\UMS.Modules.Identity.Domain\UMS.Modules.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\src\UMS.Modules\Identity\UMS.Modules.Identity.Application\UMS.Modules.Identity.Application.csproj" />
    <ProjectReference Include="..\..\src\UMS.Modules\Identity\UMS.Modules.Identity.Infrastructure\UMS.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\UMS.Modules\Notifications\UMS.Modules.Notifications.Domain\UMS.Modules.Notifications.Domain.csproj" />
    <ProjectReference Include="..\..\src\UMS.Modules\Notifications\UMS.Modules.Notifications.Application\UMS.Modules.Notifications.Application.csproj" />
    <ProjectReference Include="..\..\src\UMS.Modules\Notifications\UMS.Modules.Notifications.Infrastructure\UMS.Modules.Notifications.Infrastructure.csproj" />
  </ItemGroup>

</Project>