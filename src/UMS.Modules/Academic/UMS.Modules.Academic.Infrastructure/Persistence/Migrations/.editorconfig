# EF Core migrations are machine-generated by `dotnet ef migrations add` and regenerated whenever
# the model changes - never hand-edited/reformatted. Style rules that only fight the generated
# shape are turned off for this directory alone; every other analyzer (correctness rules, etc.)
# still applies.
root = false

[*.cs]
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.CA1861.severity = none
