<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UMS.Modules.Identity.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 10.0.11 explicitly - Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 otherwise
         pulls an older EFCore 10.0.4 transitively, conflicting with Design's 10.0.11 and
         producing an MSB3277 binding-conflict warning across every downstream project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UMS.Modules.Identity.Domain\UMS.Modules.Identity.Domain.csproj" />
    <ProjectReference Include="..\UMS.Modules.Identity.Application\UMS.Modules.Identity.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Resilience\UMS.Shared.Resilience.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Authorization\UMS.Shared.Authorization.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Outbox\UMS.Shared.Outbox.csproj" />
    <!-- Flow #6 (Organization) now exists - resolves the real cross-module existence-check
         implementation (OrganizationNodeExistenceCheckerAdapter) in place of the former
         StubOrganizationNodeExistenceChecker, the same in-process shared-interface pattern
         UMS.Shared.Audit already established. -->
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Organization\UMS.Shared.Organization.csproj" />
  </ItemGroup>

</Project>
