<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UMS.Modules.Research.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 10.0.11 explicitly - Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 otherwise pulls
         an older EFCore 10.0.4 transitively, conflicting with Design's 10.0.11 (see other modules' csproj remarks). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UMS.Modules.Research.Domain\UMS.Modules.Research.Domain.csproj" />
    <ProjectReference Include="..\UMS.Modules.Research.Application\UMS.Modules.Research.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Authorization\UMS.Shared.Authorization.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Outbox\UMS.Shared.Outbox.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Notifications\UMS.Shared.Notifications.csproj" />
    <ProjectReference Include="..\..\..\Shared\UMS.Shared.Research\UMS.Shared.Research.csproj" />
  </ItemGroup>

</Project>
