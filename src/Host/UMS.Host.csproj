<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\UMS.Shared.Observability\UMS.Shared.Observability.csproj" />
    <ProjectReference Include="..\Shared\UMS.Shared.ErrorHandling\UMS.Shared.ErrorHandling.csproj" />
    <ProjectReference Include="..\Shared\UMS.Shared.Resilience\UMS.Shared.Resilience.csproj" />
    <ProjectReference Include="..\Shared\UMS.Shared.Authorization\UMS.Shared.Authorization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Host wires each module's Api (endpoints) and Infrastructure (DI composition) - never a
      module's Domain/Application directly (module-boundaries.md: the Host is a composition root,
      not a place business logic lives). Identity is the first module (release/DEVELOPMENT_PLAN.md
      Flow #4); every later module adds its own two ProjectReference lines here the same way.
    -->
    <ProjectReference Include="..\UMS.Modules\Identity\UMS.Modules.Identity.Api\UMS.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Identity\UMS.Modules.Identity.Infrastructure\UMS.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\UMS.Modules\Audit\UMS.Modules.Audit.Api\UMS.Modules.Audit.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Audit\UMS.Modules.Audit.Infrastructure\UMS.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\UMS.Modules\Organization\UMS.Modules.Organization.Api\UMS.Modules.Organization.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Organization\UMS.Modules.Organization.Infrastructure\UMS.Modules.Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\UMS.Modules\Documents\UMS.Modules.Documents.Api\UMS.Modules.Documents.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Documents\UMS.Modules.Documents.Infrastructure\UMS.Modules.Documents.Infrastructure.csproj" />

    <!-- Notifications (release/DEVELOPMENT_PLAN.md Flow #8) - depends only on Identity
         (module-boundaries.md); resolves IAuditRecorder (Audit) and IRecipientDirectory (Identity)
         as its own cross-module read/write paths, both already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Notifications\UMS.Modules.Notifications.Api\UMS.Modules.Notifications.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Notifications\UMS.Modules.Notifications.Infrastructure\UMS.Modules.Notifications.Infrastructure.csproj" />

    <!-- Faculty (release/DEVELOPMENT_PLAN.md Flow #10) - depends on Identity + Organization
         (module-boundaries.md), both already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Faculty\UMS.Modules.Faculty.Api\UMS.Modules.Faculty.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Faculty\UMS.Modules.Faculty.Infrastructure\UMS.Modules.Faculty.Infrastructure.csproj" />

    <!-- Student — Core (release/DEVELOPMENT_PLAN.md Flow #11) - depends on Identity, Organization,
         Documents, and Notifications, all already registered above, for its real STU-2/3/4
         cross-module side effects. -->
    <ProjectReference Include="..\UMS.Modules\Student\UMS.Modules.Student.Api\UMS.Modules.Student.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Student\UMS.Modules.Student.Infrastructure\UMS.Modules.Student.Infrastructure.csproj" />
  </ItemGroup>

</Project>
