<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\UMS.Shared.Observability\UMS.Shared.Observability.csproj" />
    <ProjectReference Include="..\Shared\UMS.Shared.ErrorHandling\UMS.Shared.ErrorHandling.csproj" />
    <ProjectReference Include="..\Shared\UMS.Shared.Resilience\UMS.Shared.Resilience.csproj" />
    <ProjectReference Include="..\Shared\UMS.Shared.Authorization\UMS.Shared.Authorization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Host wires each module's Api (endpoints) and Infrastructure (DI composition) - never a
      module's Domain/Application directly (module-boundaries.md: the Host is a composition root,
      not a place business logic lives). Identity is the first module (release/DEVELOPMENT_PLAN.md
      Flow #4); every later module adds its own two ProjectReference lines here the same way.
    -->
    <ProjectReference Include="..\UMS.Modules\Identity\UMS.Modules.Identity.Api\UMS.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Identity\UMS.Modules.Identity.Infrastructure\UMS.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\UMS.Modules\Audit\UMS.Modules.Audit.Api\UMS.Modules.Audit.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Audit\UMS.Modules.Audit.Infrastructure\UMS.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\UMS.Modules\Organization\UMS.Modules.Organization.Api\UMS.Modules.Organization.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Organization\UMS.Modules.Organization.Infrastructure\UMS.Modules.Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\UMS.Modules\Documents\UMS.Modules.Documents.Api\UMS.Modules.Documents.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Documents\UMS.Modules.Documents.Infrastructure\UMS.Modules.Documents.Infrastructure.csproj" />

    <!-- Notifications (release/DEVELOPMENT_PLAN.md Flow #8) - depends only on Identity
         (module-boundaries.md); resolves IAuditRecorder (Audit) and IRecipientDirectory (Identity)
         as its own cross-module read/write paths, both already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Notifications\UMS.Modules.Notifications.Api\UMS.Modules.Notifications.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Notifications\UMS.Modules.Notifications.Infrastructure\UMS.Modules.Notifications.Infrastructure.csproj" />

    <!-- Faculty (release/DEVELOPMENT_PLAN.md Flow #10) - depends on Identity + Organization
         (module-boundaries.md), both already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Faculty\UMS.Modules.Faculty.Api\UMS.Modules.Faculty.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Faculty\UMS.Modules.Faculty.Infrastructure\UMS.Modules.Faculty.Infrastructure.csproj" />

    <!-- Student — Core (release/DEVELOPMENT_PLAN.md Flow #11) - depends on Identity, Organization,
         Documents, and Notifications, all already registered above, for its real STU-2/3/4
         cross-module side effects. -->
    <ProjectReference Include="..\UMS.Modules\Student\UMS.Modules.Student.Api\UMS.Modules.Student.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Student\UMS.Modules.Student.Infrastructure\UMS.Modules.Student.Infrastructure.csproj" />

    <!-- Academic (release/DEVELOPMENT_PLAN.md Flow #12) - depends on Identity, Organization,
         Student, and Faculty (module-boundaries.md), all already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Academic\UMS.Modules.Academic.Api\UMS.Modules.Academic.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Academic\UMS.Modules.Academic.Infrastructure\UMS.Modules.Academic.Infrastructure.csproj" />

    <!-- Learning (release/DEVELOPMENT_PLAN.md Flow #13) - depends on Identity, Organization,
         Academic, Documents, and Notifications (module-boundaries.md), all already registered
         above. Referenced last since nothing in this build depends on Learning: it is a leaf in the
         dependency graph, called only by Reporting's own documented read-only exception. -->
    <ProjectReference Include="..\UMS.Modules\Learning\UMS.Modules.Learning.Api\UMS.Modules.Learning.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Learning\UMS.Modules.Learning.Infrastructure\UMS.Modules.Learning.Infrastructure.csproj" />

    <!-- Finance — Payment Core (release/DEVELOPMENT_PLAN.md Flow #14) - depends on Identity only
         (module-boundaries.md: "Finance intentionally has no outgoing domain dependency"), plus
         Documents (FIN-15 receipt generation) and Notifications (FIN-16), both already registered
         above. -->
    <ProjectReference Include="..\UMS.Modules\Finance\UMS.Modules.Finance.Api\UMS.Modules.Finance.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Finance\UMS.Modules.Finance.Infrastructure\UMS.Modules.Finance.Infrastructure.csproj" />

    <!-- Admission (release/DEVELOPMENT_PLAN.md Flow #15) - depends on Identity, Organization,
         Finance, Documents, and Notifications (module-boundaries.md), all already registered above,
         plus Student (ADM-21's IStudentRecordProvisioner handoff), registered above by Flow #11. -->
    <ProjectReference Include="..\UMS.Modules\Admission\UMS.Modules.Admission.Api\UMS.Modules.Admission.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Admission\UMS.Modules.Admission.Infrastructure\UMS.Modules.Admission.Infrastructure.csproj" />

    <!-- Hostel (Flow #19) - depends on Identity, Student, and Finance (module-boundaries.md),
         all already registered above. Deliberately NOT Organization (requirement-spec.md §9
         decision 1: Hostel owns its own Building/Room). -->
    <ProjectReference Include="..\UMS.Modules\Hostel\UMS.Modules.Hostel.Api\UMS.Modules.Hostel.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Hostel\UMS.Modules.Hostel.Infrastructure\UMS.Modules.Hostel.Infrastructure.csproj" />

    <!-- Library (Flow #20) - depends on Identity, Student, Faculty, and Finance
         (module-boundaries.md), all already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Library\UMS.Modules.Library.Api\UMS.Modules.Library.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Library\UMS.Modules.Library.Infrastructure\UMS.Modules.Library.Infrastructure.csproj" />

    <!-- Content (Flow #24) - depends on Identity, Organization, Notifications, and Documents
         (module-boundaries.md), all already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Content\UMS.Modules.Content.Api\UMS.Modules.Content.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Content\UMS.Modules.Content.Infrastructure\UMS.Modules.Content.Infrastructure.csproj" />

    <!-- Research (Flow #25) - depends ONLY on Identity, Organization, and Faculty
         (module-boundaries.md), all already registered above; deliberately never Student, never
         Finance. -->
    <ProjectReference Include="..\UMS.Modules\Research\UMS.Modules.Research.Api\UMS.Modules.Research.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Research\UMS.Modules.Research.Infrastructure\UMS.Modules.Research.Infrastructure.csproj" />

    <!-- Alumni (Flow #29) - depends on Identity, Student (StudentGraduated consumption only, via
         UMS.Shared.Student.IStudentStatusChecker), and Finance (Donation payment delegation via
         UMS.Shared.Finance.IInvoiceRequester), all already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Alumni\UMS.Modules.Alumni.Api\UMS.Modules.Alumni.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Alumni\UMS.Modules.Alumni.Infrastructure\UMS.Modules.Alumni.Infrastructure.csproj" />

    <!-- Career (release/DEVELOPMENT_PLAN.md Flow #30) - depends on Identity, Student (Student.status
         live reads via UMS.Shared.Student.IStudentStatusChecker, plus StudentGraduated/StudentStatusChanged
         outbox consumption), Organization (IRoomExistenceChecker for a Drive's venue), and Documents
         (IUploadedArtifactRequester for ResumeProfile storage) - ZERO dependency on Alumni, Academic,
         or Finance. -->
    <ProjectReference Include="..\UMS.Modules\Career\UMS.Modules.Career.Api\UMS.Modules.Career.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Career\UMS.Modules.Career.Infrastructure\UMS.Modules.Career.Infrastructure.csproj" />

    <!-- Reporting (release/DEVELOPMENT_PLAN.md Flow #22) - ADR-0013 permits it to depend on every
         other module's own READ-ONLY cross-module reporting-query contract (Academic, Admission,
         Finance, Faculty, Hostel, Library); registered last since it depends on all of the above,
         plus Documents (RPT-13 PDF generation) and Notifications, both already registered above. -->
    <ProjectReference Include="..\UMS.Modules\Reporting\UMS.Modules.Reporting.Api\UMS.Modules.Reporting.Api.csproj" />
    <ProjectReference Include="..\UMS.Modules\Reporting\UMS.Modules.Reporting.Infrastructure\UMS.Modules.Reporting.Infrastructure.csproj" />
  </ItemGroup>

</Project>
