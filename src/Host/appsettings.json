{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Jwt": {
    "Issuer": "https://identity.ums-suite.internal",
    "Audience": "ums-suite"
  },
  "Audit": {
    "Retention": {
      "EntityTypeRetentionMonths": {}
    },
    "Storage": {
      "Bucket": "ums-documents",
      "UseHttps": false
    }
  },
  "AllowedHosts": "*"
}
